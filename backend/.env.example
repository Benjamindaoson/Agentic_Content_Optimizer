# ==================== 应用基础配置 ====================
ENVIRONMENT=development
DEBUG=True

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://user:password@localhost:5432/growth_flywheel

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== MinIO 配置 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ==================== Qdrant 配置 ====================
QDRANT_URL=http://localhost:6333

# ==================== JWT 配置 ====================
# 生产环境必须设置为至少32字符的随机密钥
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ==================== CORS 配置 ====================
# 逗号分隔的允许来源列表
# 生产环境必须指定具体域名，不能使用 *
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== LLM API Keys ====================
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
QWEN_API_KEY=your-qwen-api-key

# ==================== 多模态内容生产 ====================
RUNWAYML_API_SECRET=your-runway-api-secret
RUNWAYML_API_BASE=https://api.dev.runwayml.com
RUNWAYML_API_VERSION=2024-11-06
RUNWAYML_MODEL=gen4.5
RUNWAYML_RATIO=720:1280
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
MULTIMODAL_ARTIFACT_DIR=backend/runtime/multimodal
MULTIMODAL_DURABLE_STORAGE_ENABLED=false
MULTIMODAL_ARTIFACT_BUCKET=videos
MULTIMODAL_LLM_PROVIDER=claude
MULTIMODAL_LLM_MODEL=
MULTIMODAL_JUDGE_ENABLED=false
MULTIMODAL_JUDGE_MODEL=gpt-6-astra
MULTIMODAL_JUDGE_SAMPLE_COUNT=4
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TIKTOK_CONTENT_POSTING_ENABLED=false
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE=https://open.tiktokapis.com
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ==================== LangSmith 配置 ====================
LANGCHAIN_API_KEY=your-langsmith-api-key

# ==================== 生产环境示例 ====================
# ENVIRONMENT=production
# DEBUG=False
# JWT_SECRET=<使用 secrets.token_urlsafe(32) 生成>
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# DATABASE_URL=postgresql://prod_user:secure_password@db.example.com:5432/growth_flywheel_prod
# REDIS_URL=redis://:secure_password@redis.example.com:6379/0
