# Database
POSTGRES_PASSWORD=your_secure_password_here

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# vLLM API
VLLM_API_KEY=your_vllm_api_key_here

# External APIs
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Multimodal Content Production
RUNWAYML_API_SECRET=your_runway_api_secret_here
RUNWAYML_API_BASE=https://api.dev.runwayml.com
RUNWAYML_API_VERSION=2024-11-06
RUNWAYML_MODEL=gen4.5
RUNWAYML_RATIO=720:1280
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
MULTIMODAL_ARTIFACT_DIR=backend/runtime/multimodal
MULTIMODAL_DURABLE_STORAGE_ENABLED=false
MULTIMODAL_ARTIFACT_BUCKET=videos
MULTIMODAL_LLM_PROVIDER=claude
MULTIMODAL_LLM_MODEL=
MULTIMODAL_JUDGE_ENABLED=false
MULTIMODAL_JUDGE_MODEL=gpt-5.6-luna
MULTIMODAL_JUDGE_SAMPLE_COUNT=4
MULTIMODAL_SUBTITLES_ENABLED=true
MULTIMODAL_BRAND_TEXT=
MULTIMODAL_BRAND_FONT=DejaVu Sans
MULTIMODAL_BRAND_FONT_SIZE=28
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TIKTOK_CONTENT_POSTING_ENABLED=false
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE=https://open.tiktokapis.com
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Grafana
GRAFANA_PASSWORD=your_grafana_password_here

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Redis
REDIS_MAX_CONNECTIONS=50

# Feature Flags (v4.0 Lite Configuration)
ENABLE_AUTO_ACCOUNT_MANAGER=true
ENABLE_MULTIMODAL_COVER=true
ENABLE_MULTI_PLATFORM=false  # Lite: 只支持小红书
ENABLE_CAUSAL_INFERENCE=false  # Lite: 样本不足时禁用
ENABLE_AUTO_PUBLISH=false  # Lite: 需要人工审批

# Decision Boundaries
DECISION_TOPIC_SELECTION=semi_auto  # fully_auto | semi_auto | manual_only
DECISION_CONTENT_GENERATION=semi_auto
DECISION_COVER_GENERATION=fully_auto
DECISION_PUBLISH=manual_only
DECISION_STRATEGY_ADJUSTMENT=semi_auto

# Performance Settings
CACHE_L1_MAX_SIZE=1000
CACHE_L2_TTL_SECONDS=3600
PARALLEL_EXECUTOR_MAX_WORKERS=10
FAST_PATH_TIMEOUT_SECONDS=2
NORMAL_PATH_TIMEOUT_SECONDS=10

# LLM Settings
LLM_PROVIDER=vllm  # vllm | anthropic | openai
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-3-5-haiku-20241022
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# Image Generation Settings
IMAGE_PROVIDER=comfyui  # comfyui | dalle | sdxl
IMAGE_FALLBACK_PROVIDER=dalle
IMAGE_BATCH_SIZE=3
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# Causal Inference Settings
CAUSAL_MIN_SAMPLE_SIZE=1000
CAUSAL_RECOMMENDED_SAMPLE_SIZE=5000
CAUSAL_CONFIDENCE_THRESHOLD=0.7

# Platform Settings
SUPPORTED_PLATFORMS=xiaohongshu  # Lite: 只支持小红书
# SUPPORTED_PLATFORMS=xiaohongshu,douyin,bilibili  # Full 版本

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
METRICS_EXPORT_INTERVAL_SECONDS=60
ALERT_SLACK_WEBHOOK_URL=
ALERT_PAGERDUTY_ROUTING_KEY=
ALERT_MIN_LEVEL=WARNING

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# XHS Scraper (Production)
XHS_SCRAPER_MODE=playwright  # creator_api | playwright
XHS_CREATOR_API_BASE=
XHS_CREATOR_API_TOKEN=
XHS_SELECTORS_CONFIG_PATH=backend/config/crawlers/xhs_selectors.json
XHS_STORAGE_STATE_DIR=backend/runtime/xhs_sessions
XHS_SCRAPER_HEADLESS=true
XHS_SCRAPER_MAX_RETRIES=3
XHS_SCRAPER_TIMEOUT_MS=20000
XHS_SCRAPER_SNAPSHOT_DIR=backend/runtime/scraper_snapshots
XHS_CRAWL_ENABLED=false
XHS_CRAWL_ACCEPT_POLICY=false
XHS_ALLOWED_DOMAINS=www.xiaohongshu.com,xiaohongshu.com

# Startup hardening
STARTUP_INIT_TIMEOUT_SEC=30
STARTUP_OPTIONAL_TIMEOUT_SEC=8
STARTUP_ALLOW_PARTIAL_ROUTERS=true
STARTUP_ROUTER_IMPORT_TIMEOUT_SEC=6
STARTUP_DEFER_OPTIONAL_INIT=true
STARTUP_ENABLE_SYSTEM_UPGRADE=false
STARTUP_ENABLE_ONLINE_LEARNING=false
STARTUP_ENABLE_MLOPS=false
HEALTHCHECK_TIMEOUT_SEC=2
