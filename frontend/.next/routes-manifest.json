{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/control-center",
      "regex": "^/control\\-center(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/control\\-center(?:/)?$"
    },
    {
      "page": "/dashboard-new.deprecated",
      "regex": "^/dashboard\\-new\\.deprecated(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard\\-new\\.deprecated(?:/)?$"
    },
    {
      "page": "/data-import",
      "regex": "^/data\\-import(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/data\\-import(?:/)?$"
    },
    {
      "page": "/generate",
      "regex": "^/generate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/generate(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/strategy-analytics",
      "regex": "^/strategy\\-analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/strategy\\-analytics(?:/)?$"
    },
    {
      "page": "/viral",
      "regex": "^/viral(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/viral(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}