# =============================================================================
# Growth Flywheel 2.5 — Lite Edition 环境变量模板
# 仅保留核心配置，移除 GPU、MinIO 和监控系统相关变量。
# =============================================================================

# 1. 数据库配置 (gf-lite-postgres)
POSTGRES_PASSWORD=gf_dev_2025

# 2. LLM 配置 (必填其一)
# 推荐使用 DeepSeek，其性价比最高且高度兼容 OpenAI 接口。
LLM_PROVIDER=deepseek

# API Key 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 3. 基础应用配置
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# 4. API 访问配置 (用于前端连接后端)
# 如果在本地运行，通常不需要修改。
NEXT_PUBLIC_API_URL=http://localhost:8080

# 5. 性能与缓存
# 默认启用语义缓存以降低 Token 成本
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_L2_TTL_SECONDS=3600

# 6. 功能开关 (Lite 版本)
ENABLE_AUTO_ACCOUNT_MANAGER=false
ENABLE_MULTIMODAL_COVER=false
ENABLE_CAUSAL_INFERENCE=false
ENABLE_AUTO_PUBLISH=false

# 7. 速率限制
RATE_LIMIT_PER_MINUTE=60
